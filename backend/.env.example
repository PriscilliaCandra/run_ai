# AI Provider Settings
# LLM_PROVIDER can be 'auto', 'gemini', or 'openai'
LLM_PROVIDER=auto

# Optional: Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./running_research.db

# --- Environment ---
# 'development' or 'production'. Controls cookie Secure flag and other
# environment-sensitive behavior. Set to 'production' only on a real HTTPS
# deployment.
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication / sessions ---
SESSION_COOKIE_NAME=session_token
SESSION_TTL_HOURS=168
# Must be 'true' in production (HTTPS only). Keep 'false' for local http dev.
SESSION_COOKIE_SECURE=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Email (password reset) ---
# No email provider is integrated yet. Leave EMAIL_PROVIDER empty to log
# reset links to the server console instead of sending real email (dev-safe
# default). Documented here so a real provider (e.g. Resend/SendGrid/SES)
# can be wired into app/auth/email_service.py later without guessing at
# what configuration it needs.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
FRONTEND_BASE_URL=http://localhost:5173

# --- Rate limiting ---
# Format: "<count>/<period>", e.g. "5/minute", "20/hour".
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_PASSWORD_RESET=3/hour
RATE_LIMIT_PLAN_GENERATION=20/hour
RATE_LIMIT_WORKOUT_WRITE=60/hour
